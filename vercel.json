{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest|sw\\.js|icon\\.svg|pwa-.*\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
