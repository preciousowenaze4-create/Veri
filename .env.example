# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIVESIM_API_KEY: Private 5sim.net API token for dedicated non-shared OTP numbers.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
FIVESIM_API_KEY="MY_FIVESIM_API_KEY"

# GRIZZLYSMS_API_KEY: Private Grizzly SMS (grizzlysms.com) API key for cheap OTP numbers.
# Configure in the Secrets panel in AI Studio UI or Vercel Environment Variables.
GRIZZLYSMS_API_KEY="MY_GRIZZLYSMS_API_KEY"

# PAYSTACK_SECRET_KEY: Live secret key (sk_live_...) for customer wallet deposits & webhook verification.
# Configure in the Secrets panel in AI Studio UI and in Vercel Environment Variables.
PAYSTACK_SECRET_KEY="MY_PAYSTACK_SECRET_KEY"

# USD_TO_NGN_RATE: Optional custom dollar-to-naira rate (e.g. 1500). Defaults to live market rate.
USD_TO_NGN_RATE="1500"

# SUPABASE CREDENTIALS (Vercel + Client):
# Paste these in your Vercel Project Settings -> Environment Variables.
# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY power instant server-side wallet crediting & Paystack webhooks.
# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY power live client-side balance updates.
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# CUSTOM DOMAIN EMAIL (veribox.name.ng on Truehost + Cloudflare Email Routing / Webhook):
# EMAIL_DOMAIN defaults to veribox.name.ng.
# Set INBOUND_EMAIL_SECRET to secure POST /api/email/inbound webhooks from Cloudflare Email Workers.
EMAIL_DOMAIN="veribox.name.ng"
INBOUND_EMAIL_SECRET="MY_INBOUND_EMAIL_SECRET"

